---
import PlaceholderNotice from "../components/ui/PlaceholderNotice.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="冥獄城とは">
  <article class="container">
    <header>
      <h1>冥獄城とは</h1>
    </header>
    <section aria-labelledby="overview-title">
      <h2 id="overview-title">冥獄城の概要</h2>
      <PlaceholderNotice>【公開原稿確認中】</PlaceholderNotice>
    </section>
    <section aria-labelledby="worldview-title">
      <h2 id="worldview-title">世界観</h2>
      <PlaceholderNotice>【承認後に掲載】</PlaceholderNotice>
    </section>
    <section aria-labelledby="discord-title">
      <h2 id="discord-title">Discordコミュニティとしての説明</h2>
      <PlaceholderNotice>【説明文未確定】</PlaceholderNotice>
    </section>
  </article>
</BaseLayout>
