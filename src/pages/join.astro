---
import { canShowInvite, joinConfig, recruitmentMessages } from "../data/join";
import { nextSessionLabel } from "../lib/join";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/site-pages.css";
const nextSession = nextSessionLabel();
const steps = [["Discordへ参加する", "招待リンクから冥獄城へ参加します。"],["「説明会待ち」として案内を確認する", "参加直後は、入城に必要な案内を確認します。最初から城内のすべてが見えるわけではありません。"],["希望する時間を送る", "21時、22時、23時の説明会から希望する時間を選びます。月曜日と木曜日は休止しています。"],["説明会または時間外面接を受ける", "通常時間が合わない場合は、30分単位の時間外面接を相談できます。"],["初回案内を確認する", "説明後に開く初回案内から、城内の基本的な歩き方や最初に見る場所を確認します。"],["亡霊として城内へ入る", "最初の身分は「亡霊」です。人や空間に触れながら、少しずつ過ごし方を知っていきます。"]];
const faqs = [["世界観を全部覚えてから入る必要はありますか？", "ありません。必要な内容は、説明会と入城後の案内で順に確認できます。"],["通話でうまく話せる自信がありません。", "入城直後から会話の中心になる必要はありません。まず人の声を聞き、短い反応を返し、雰囲気を知るところから始められます。"],["説明会では何を聞かれますか？", "世界観の知識や会話力を試す試験ではありません。冥獄城の基本的な説明と、利用上必要な確認を行います。"],["21時、22時、23時に参加できません。", "時間外面接を30分単位で相談できます。Discord参加後、案内に沿って希望時間を伝えてください。"],["魂の診断を受ける必要はありますか？", "必須ではありません。診断結果は入城の可否、身分、評価、役職適性には影響しません。"],["入城すると、すぐ役職や仕事を決める必要がありますか？", "ありません。まず亡霊として城を知り、交流しながら過ごします。仕事や役職は魔人以上になってから選べます。"]];
---
<BaseLayout title="入城案内" description="冥獄城への参加、説明会、時間外面接、入城後の流れを案内します。"><article class="site-page"><section class="site-page__hero"><div class="container"><p class="site-page__eyebrow">ENTER THE CASTLE</p><h1>入城案内</h1><p class="site-page__hero-copy">冥獄城へ入るまでを、順に案内します。世界観を覚えてから来る必要も、最初からうまく話す必要もありません。</p><div class="site-page__hero-actions">{canShowInvite() && <a class="site-page__cta" href={joinConfig.inviteUrl} target="_blank" rel="noopener noreferrer">Discordで城門を叩く <span aria-hidden="true">↗</span><span class="sr-only">（外部リンク）</span></a>}<a class="site-page__cta site-page__cta--quiet" href="/soul-reading">魂の診断を受ける</a></div></div></section><section class="site-page__section site-page__section--interior"><div class="container site-page__section-grid"><p class="site-page__section-heading">現在の案内</p><div class="site-page__content"><p class="site-page__eyebrow">{recruitmentMessages[joinConfig.recruitmentState]}</p><h2>{nextSession ?? "説明会の日程は入城後にご確認ください"}</h2><div class="site-page__route"><article class="site-page__card"><h3>通常説明会</h3><p>{joinConfig.sessionTimes.join(" / ")} JST</p><p>月曜日・木曜日は休止です。</p></article><article class="site-page__card"><h3>時間外面接</h3><p>{joinConfig.outOfHoursInterview}</p><p>通常時間が合わない場合は、Discord参加後に案内に沿って相談できます。</p></article></div></div></div></section><section class="site-page__section"><div class="container site-page__section-grid"><p class="site-page__section-heading">入城までの流れ</p><div class="site-page__content"><h2>一人で進められるように、順番があります。</h2><ol class="site-page__steps">{steps.map(([title, text]) => <li><div><h3>{title}</h3><p>{text}</p></div></li>)}</ol></div></div></section><section class="site-page__section site-page__section--muted"><div class="container site-page__section-grid"><p class="site-page__section-heading">よくある質問</p><div class="site-page__content"><h2>説明会は、試験ではありません。</h2><p class="site-page__lead">冥獄城の世界観、基本的な決まり、城内での過ごし方を知るための時間です。世界観の知識や、会話のうまさを判定する場ではありません。分からないことは、その場で質問できます。</p><div class="site-page__faq">{faqs.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div><div class="site-page__note">入城後には、人との交流や城内での関わりを見ながら評価が始まります。説明会・時間外面接と、身分評価は別の段階です。</div></div></div></section></article></BaseLayout>
