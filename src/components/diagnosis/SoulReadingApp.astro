<section class="soul-reading" aria-labelledby="soul-reading-title" data-soul-reading>
  <div class="soul-reading__shell">
    <div class="soul-reading__app" aria-live="polite"></div>
  </div>
</section>

<script>
  import type { SoulId } from "../../data/brand";
  import { activities, axes, axisLabels, soulQuestions } from "../../data/soul-reading";
  import { soulResultTypes } from "../../data/soul-results";
  import { siteConfig } from "../../data/site";
  import { calculateSoulReading } from "../../lib/soul-reading";
  import type { SavedSoulReadingProgress, SoulReadingProgressScreen } from "../../lib/soul-reading-progress";
  import { attachSoulShare } from "../../scripts/soul-share";
  import {
    clearSoulReadingProgress,
    loadSoulReadingProgress,
    saveSoulReadingProgress,
    soulReadingProgressStorageKey
  } from "../../scripts/soul-reading-storage";

  const root = document.querySelector<HTMLElement>("[data-soul-reading]");
  const app = root?.querySelector<HTMLElement>(".soul-reading__app");
  if (!root || !app) throw new Error("Soul reading root was not found.");

  type Screen = "start" | SoulReadingProgressScreen | "share";
  const state = {
    screen: "start" as Screen,
    index: 0,
    answers: [] as number[],
    interests: [] as string[],
    wishes: [] as string[],
    flaggedQuestions: [] as number[],
    reviewingQuestion: false,
    reviewingPick: false,
    confirmingDiscard: false
  };
  let resumableProgress = loadSoulReadingProgress();
  let externalProgress: SavedSoulReadingProgress | undefined;
  const kanji = ["一", "二", "三", "四", "五", "六", "七", "八", "九", "十", "十一", "十二", "十三", "十四"];
  const activityNotes: Record<string, string> = {
    social: "人の声と、日々のやり取りに触れられる場所。",
    events: "遊びや企画をきっかけに、同じ時間を過ごせる場所。",
    creation: "自分の好きなものを置き、会話の目印にできる場所。",
    economy: "Landや商館を通じて、城内の営みに触れられる場所。",
    planning: "手伝いながら、誰かと一つのものを作れる場所。",
    streaming: "見ること・話すことから、城の流れへ入れる場所。"
  };

  const element = (tag: string, className?: string, text?: string) => {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  };
  const heading = (level: 1 | 2, text: string, className?: string) => {
    const node = element(`h${level}`, className, text);
    node.tabIndex = -1;
    return node;
  };
  const button = (text: string, className: string, action: () => void) => {
    const node = element("button", className, text) as HTMLButtonElement;
    node.type = "button";
    node.addEventListener("click", action);
    return node;
  };
  const crest = (id: SoulId, variant: "full" | "compact" = "full", className = "soul-reading__crest") => {
    const image = document.createElement("img");
    image.className = className;
    image.src = `/images/brand/crest/crest-${id}${variant === "compact" ? "-min" : ""}.svg`;
    image.alt = `${soulResultTypes.find((type) => type.id === id)?.name ?? "魂"}の魂紋`;
    image.width = 100;
    image.height = 100;
    return image;
  };
  const sectionLabel = (text: string) => element("p", "soul-reading__label", text);
  const resultUrlShare = (soulId: SoulId) => {
    const control = element("div", "soul-reading__url-share");
    control.dataset.soulShare = "";
    control.dataset.soulId = soulId;
    const shareButton = button("結果URLを共有", "soul-reading__button soul-reading__button--outline", () => undefined);
    shareButton.dataset.soulShareButton = "";
    const status = element("p", "soul-reading__share-status");
    status.dataset.soulShareStatus = "";
    status.setAttribute("aria-live", "polite");
    const manual = element("div", "soul-reading__manual-copy");
    manual.dataset.soulShareManual = "";
    manual.hidden = true;
    const label = element("label", undefined, "結果URL") as HTMLLabelElement;
    const input = document.createElement("input");
    input.type = "text";
    input.readOnly = true;
    input.id = `soul-result-url-${soulId}`;
    label.htmlFor = input.id;
    manual.append(label, input);
    control.append(shareButton, status, manual);
    attachSoulShare(control);
    return control;
  };
  const resetReading = () => {
    state.screen = "start";
    state.index = 0;
    state.answers = [];
    state.interests = [];
    state.wishes = [];
    state.flaggedQuestions = [];
    state.reviewingQuestion = false;
    state.reviewingPick = false;
    state.confirmingDiscard = false;
  };
  const restoreReading = (progress: SavedSoulReadingProgress) => {
    state.screen = progress.screen;
    state.index = progress.index;
    state.answers = [...progress.answers];
    state.interests = [...progress.interests];
    state.wishes = [...progress.wishes];
    state.flaggedQuestions = [...progress.flaggedQuestions];
    state.reviewingQuestion = false;
    state.reviewingPick = false;
  };
  const hasFinishedReading = () => state.answers.length === 12 && state.interests.length === 2 && state.wishes.length === 2;
  const inProgressPayload = (): SavedSoulReadingProgress | undefined => {
    if (!["question", "interlude", "pick", "review"].includes(state.screen)) return undefined;
    const reviewing = state.reviewingQuestion || state.reviewingPick;
    return {
      version: 1,
      updatedAt: new Date().toISOString(),
      status: "in-progress",
      // An edit view always resumes at review, never as a normal-progress question.
      screen: reviewing ? "review" : state.screen as SoulReadingProgressScreen,
      index: reviewing ? 13 : state.index,
      answers: [...state.answers],
      interests: [...state.interests],
      wishes: [...state.wishes],
      flaggedQuestions: [...state.flaggedQuestions]
    };
  };
  const persistInProgress = () => {
    const progress = inProgressPayload();
    if (progress) saveSoulReadingProgress(progress);
    return progress;
  };
  const persistCompleted = () => {
    if (!hasFinishedReading()) return undefined;
    const progress: SavedSoulReadingProgress = {
      version: 1,
      updatedAt: new Date().toISOString(),
      status: "completed",
      screen: "result",
      index: 13,
      answers: [...state.answers],
      interests: [...state.interests],
      wishes: [...state.wishes],
      flaggedQuestions: [...state.flaggedQuestions]
    };
    saveSoulReadingProgress(progress);
    return progress;
  };
  const discardReading = () => {
    clearSoulReadingProgress();
    resumableProgress = undefined;
  };
  const renderDiscardConfirmation = () => {
    const confirmation = element("section", "soul-reading__discard-confirmation");
    confirmation.setAttribute("role", "dialog");
    confirmation.setAttribute("aria-labelledby", "soul-reading-discard-title");
    confirmation.append(
      heading(2, "途中の回答を消して、最初から始めますか。", "soul-reading__discard-title"),
      button("回答を消して始める", "soul-reading__button soul-reading__button--primary", () => {
        discardReading();
        resetReading();
        state.screen = "question";
        render();
      }),
      button("戻る", "soul-reading__button soul-reading__button--quiet", () => {
        state.confirmingDiscard = false;
        render();
      })
    );
    confirmation.querySelector("h2")?.setAttribute("id", "soul-reading-discard-title");
    return confirmation;
  };
  const renderExternalUpdateNotice = () => {
    if (!externalProgress) return;
    const notice = element("aside", "soul-reading__external-update");
    notice.setAttribute("role", "status");
    notice.append(
      element("p", undefined, "別のタブで回答が更新されました。"),
      button("最新の回答を読み込む", "soul-reading__button soul-reading__button--outline", () => {
        if (!externalProgress) return;
        restoreReading(externalProgress);
        resumableProgress = undefined;
        externalProgress = undefined;
        render();
      }),
      button("このまま続ける", "soul-reading__button soul-reading__button--quiet", () => {
        externalProgress = undefined;
        if (state.screen === "reveal" || state.screen === "result" || state.screen === "share") persistCompleted();
        else persistInProgress();
        render();
      })
    );
    app.append(notice);
  };
  const clear = () => app.replaceChildren();
  const focusScreen = () => requestAnimationFrame(() => {
    document.getElementById("main-content")?.scrollIntoView({ block: "start" });
    app.querySelector<HTMLElement>("h1, h2")?.focus();
  });
  const render = () => {
    clear();
    if (state.screen === "start") renderStart();
    else if (state.screen === "question") renderQuestion();
    else if (state.screen === "interlude") renderInterlude();
    else if (state.screen === "pick") renderPick();
    else if (state.screen === "review") renderReview();
    else if (state.screen === "reveal") renderReveal();
    else if (state.screen === "result") renderResult();
    else renderShare();
    renderExternalUpdateNotice();
    focusScreen();
  };

  const renderStart = () => {
    const panel = element("section", "soul-reading__screen soul-reading__start");
    const content = element("div", "soul-reading__intro-content");
    content.append(sectionLabel("SOUL READING"));
    content.append(heading(1, "これから、通話の夜を\n十二回くぐります。", "soul-reading__start-title"));
    content.append(element("div", "soul-reading__rule"));
    content.append(element("p", "soul-reading__start-copy", "正解はありません。うまい返しを選ぶ必要もありません。\n実際にそうなりやすい方を選んでください。\n最後に、城で気になるものと、一か月後の希望を二つずつ聞きます。"));
    const notes = element("ul", "soul-reading__notes");
    ["十二の場面と、二つの城内質問。約三分で終わります。", "回答は端末の中だけで判定します。サーバーへは送りません。", "入城の可否、身分、評価、役職適性とは関係ありません。"].forEach((note) => notes.append(element("li", undefined, note)));
    content.append(notes);
    content.append(element("p", "soul-reading__privacy-note", "回答はこの端末のブラウザ内にだけ保存されます。外部送信はせず、30日後または「最初からやり直す」で削除されます。"));
    if (resumableProgress?.status === "in-progress") {
      const resume = element("aside", "soul-reading__resume");
      resume.append(
        sectionLabel("SAVED IN THIS BROWSER"),
        element("p", "soul-reading__resume-copy", "前回の回答がこのブラウザに保存されています。30日間、続きから再開できます。"),
        button("前回の続きから", "soul-reading__button soul-reading__button--primary", () => {
          if (!resumableProgress) return;
          restoreReading(resumableProgress);
          resumableProgress = undefined;
          render();
        }),
        button("最初からやり直す", "soul-reading__button soul-reading__button--quiet", () => {
          state.confirmingDiscard = true;
          render();
        })
      );
      content.append(resume);
    } else if (resumableProgress?.status === "completed") {
      const resume = element("aside", "soul-reading__resume");
      resume.append(
        sectionLabel("SAVED RESULT IN THIS BROWSER"),
        heading(2, "前回の結果が残っています", "soul-reading__resume-title"),
        element("p", "soul-reading__resume-copy", "この端末で前回の結果をもう一度見られます。"),
        button("前回の結果を見る", "soul-reading__button soul-reading__button--primary", () => {
          if (!resumableProgress) return;
          restoreReading(resumableProgress);
          resumableProgress = undefined;
          render();
        }),
        button("もう一度診断する", "soul-reading__button soul-reading__button--quiet", () => {
          state.confirmingDiscard = true;
          render();
        })
      );
      content.append(resume);
    } else {
      content.append(button("門をくぐる", "soul-reading__button soul-reading__button--primary", () => {
        discardReading();
        resetReading();
        state.screen = "question";
        render();
      }));
    }
    if (state.confirmingDiscard) content.append(renderDiscardConfirmation());
    panel.append(content); app.append(panel);
  };

  const progressHeader = (current: number) => {
    const header = element("header", "soul-reading__question-header");
    header.append(sectionLabel("MEIGOKU / SOUL READING"));
    const count = element("p", "soul-reading__question-count");
    count.append(element("strong", undefined, kanji[current]), document.createTextNode(" / 十四"));
    header.append(count);
    const marks = element("div", "soul-reading__progress");
    marks.setAttribute("aria-label", `進捗 ${current + 1} / 14`);
    for (let index = 0; index < 14; index += 1) {
      const mark = element("span", index < current ? "is-complete" : index === current ? "is-current" : "");
      marks.append(mark);
    }
    const wrap = document.createDocumentFragment();
    wrap.append(header, marks);
    return wrap;
  };

  const goBackFromQuestion = () => {
    if (state.reviewingQuestion) {
      state.reviewingQuestion = false;
      state.screen = "review";
    } else if (state.index === 0) {
      resumableProgress = persistInProgress();
      state.screen = "start";
    }
    else state.index -= 1;
    if (state.screen !== "start") persistInProgress();
    render();
  };
  const toggleFlaggedQuestion = () => {
    const at = state.flaggedQuestions.indexOf(state.index);
    if (at >= 0) state.flaggedQuestions.splice(at, 1);
    else state.flaggedQuestions.push(state.index);
    persistInProgress();
    render();
  };
  const choose = (answer: number) => {
    state.answers[state.index] = answer;
    if (state.reviewingQuestion) {
      state.reviewingQuestion = false;
      state.screen = "review";
      persistInProgress();
      render();
      return;
    }
    const next = state.index + 1;
    state.index = next;
    state.screen = next === 6 ? "interlude" : next >= 12 ? "pick" : "question";
    persistInProgress();
    render();
  };
  const renderQuestion = () => {
    const question = soulQuestions[state.index];
    const panel = element("section", "soul-reading__screen soul-reading__question-screen");
    panel.append(progressHeader(state.index));
    const content = element("div", "soul-reading__question-content");
    const meta = element("div", "soul-reading__question-meta");
    meta.append(sectionLabel(question.scene), element("p", "soul-reading__chapter", question.chapter));
    content.append(meta, heading(2, question.text, "soul-reading__question-title"));
    const options = element("div", "soul-reading__options");
    question.options.forEach((option, index) => {
      const selected = state.answers[state.index] === index;
      const optionButton = button("", `soul-reading__option${selected ? " is-selected" : ""}`, () => choose(index));
      optionButton.setAttribute("aria-label", `${String.fromCharCode(65 + index)}. ${option.text}`);
      optionButton.setAttribute("aria-pressed", String(selected));
      optionButton.append(element("span", "soul-reading__option-key", String.fromCharCode(65 + index)), element("span", "soul-reading__option-text", option.text));
      options.append(optionButton);
    });
    content.append(options);
    const footer = element("div", "soul-reading__question-footer");
    const flagged = state.flaggedQuestions.includes(state.index);
    const flag = button(flagged ? "見直し候補に追加済み" : "あとで見直す", `soul-reading__back soul-reading__flag${flagged ? " is-flagged" : ""}`, toggleFlaggedQuestion);
    flag.setAttribute("aria-pressed", String(flagged));
    footer.append(element("span", undefined, "正解・不正解はありません"), flag, button(state.reviewingQuestion ? "← 見直しへ戻る" : "← 一つ戻る", "soul-reading__back", goBackFromQuestion));
    content.append(footer); panel.append(content); app.append(panel);
  };

  const renderInterlude = () => {
    const panel = element("section", "soul-reading__screen soul-reading__interlude");
    const content = element("div", "soul-reading__interlude-content");
    const lamps = element("div", "soul-reading__lamps");
    lamps.setAttribute("aria-label", "十二の灯のうち六つが点いています");
    for (let index = 0; index < 12; index += 1) lamps.append(element("span", index < 6 ? "is-lit" : ""));
    content.append(lamps, heading(1, "ここまでは、通話へ入った\n直後のあなた。", "soul-reading__interlude-title"), element("div", "soul-reading__rule"), element("p", "soul-reading__interlude-copy", "ここからは、少し慣れてからのあなたを見ます。"));
    content.append(button("先へ進む", "soul-reading__button soul-reading__button--outline", () => { state.screen = "question"; persistInProgress(); render(); }));
    panel.append(content); app.append(panel);
  };

  const pairData = () => {
    const interests = state.index === 12;
    return {
      interests,
      selected: interests ? state.interests : state.wishes,
      scene: interests ? "城内関心 — 十三" : "一か月後の希望 — 十四",
      title: interests ? "入城後、まず覗いてみたいものはどれですか。" : "一か月後、城でできていたらうれしいものはどれですか。",
      hint: interests ? "ここで選んだ二つが、結果の活動カードにそのまま出ます。" : "魂型の判定には使いません。",
      buttonLabel: state.reviewingPick ? "見直しへ戻る" : interests ? "次へ" : "回答を見直す"
    };
  };
  const togglePair = (id: string) => {
    const selected = state.index === 12 ? state.interests : state.wishes;
    const at = selected.indexOf(id);
    if (at >= 0) selected.splice(at, 1);
    else if (selected.length < 2) selected.push(id);
    persistInProgress();
    render();
  };
  const backFromPick = () => {
    if (state.reviewingPick) {
      state.reviewingPick = false;
      state.screen = "review";
    } else if (state.index === 12) { state.index = 11; state.screen = "question"; }
    else state.index = 12;
    persistInProgress();
    render();
  };
  const nextFromPick = () => {
    const selected = state.index === 12 ? state.interests : state.wishes;
    if (selected.length !== 2) return;
    if (state.reviewingPick) {
      state.reviewingPick = false;
      state.screen = "review";
    } else if (state.index === 12) state.index = 13;
    else state.screen = "review";
    persistInProgress();
    render();
  };
  const renderPick = () => {
    const data = pairData();
    const selected = data.selected;
    const panel = element("section", "soul-reading__screen soul-reading__question-screen soul-reading__pick-screen");
    panel.append(progressHeader(state.index));
    const content = element("div", "soul-reading__question-content");
    content.append(sectionLabel(data.scene), heading(2, data.title, "soul-reading__question-title"), element("p", "soul-reading__pick-count", `二つ選んでください（${selected.length}／2）　${selected.length === 2 ? "一つ外すと選び直せます" : "当てはまるものを二つだけ選んでください"}`), element("p", "soul-reading__pick-hint", data.hint));
    const choices = element("div", "soul-reading__pick-options");
    activities.forEach((activity) => {
      const chosen = selected.includes(activity.id);
      const choice = button("", `soul-reading__option soul-reading__pick-option${chosen ? " is-selected" : ""}`, () => togglePair(activity.id));
      choice.disabled = selected.length === 2 && !chosen;
      choice.setAttribute("aria-pressed", String(chosen));
      choice.append(element("span", "soul-reading__choice-mark"), element("span", "soul-reading__option-text", data.interests ? activity.question13 : activity.question14));
      choices.append(choice);
    });
    content.append(choices);
    const controls = element("div", "soul-reading__pick-controls");
    const next = button(data.buttonLabel, "soul-reading__button soul-reading__button--primary", nextFromPick);
    next.disabled = selected.length !== 2;
    controls.append(next, button("← 一つ戻る", "soul-reading__back", backFromPick));
    content.append(controls); panel.append(content); app.append(panel);
  };

  const openReviewQuestion = (index: number) => {
    state.index = index;
    state.reviewingQuestion = true;
    state.screen = "question";
    persistInProgress();
    render();
  };
  const openReviewPick = (index: 12 | 13) => {
    state.index = index;
    state.reviewingPick = true;
    state.screen = "pick";
    persistInProgress();
    render();
  };
  const renderReview = () => {
    const panel = element("section", "soul-reading__screen soul-reading__review");
    const content = element("div", "soul-reading__review-content");
    content.append(
      sectionLabel("REVIEW YOUR ANSWERS"),
      heading(1, "十四の答えを見直す", "soul-reading__review-title"),
      element("p", "soul-reading__review-copy", "選び直したい回答だけを開けます。ここまでの答えは、城や身分の可否を決めるものではありません。")
    );
    const questions = element("ol", "soul-reading__review-list");
    Array.from(soulQuestions.entries()).sort(([left], [right]) => Number(state.flaggedQuestions.includes(right)) - Number(state.flaggedQuestions.includes(left))).forEach(([index, question]) => {
      const answer = question.options[state.answers[index]];
      const item = element("li", `soul-reading__review-item${state.flaggedQuestions.includes(index) ? " is-flagged" : ""}`);
      const copy = element("div", "soul-reading__review-copy-block");
      copy.append(
        element("p", "soul-reading__review-meta", `Q${index + 1} / ${question.scene}`),
        element("p", "soul-reading__review-question", question.text),
        element("p", "soul-reading__review-answer", answer?.text ?? "未回答")
      );
      if (state.flaggedQuestions.includes(index)) copy.append(element("p", "soul-reading__review-flag", "見直し候補に追加済み"));
      item.append(copy, button("選び直す", "soul-reading__button soul-reading__button--quiet", () => openReviewQuestion(index)));
      questions.append(item);
    });
    content.append(questions);
    const picks = element("div", "soul-reading__review-picks");
    ([
      [12, "城でまず気になっているもの", state.interests],
      [13, "一か月後に望んでいること", state.wishes]
    ] as const).forEach(([index, label, selected]) => {
      const section = element("section", "soul-reading__review-pick");
      section.append(sectionLabel(label), element("p", undefined, selected.map((id) => {
        const activity = activities.find((item) => item.id === id);
        return activity ? index === 12 ? activity.question13 : activity.question14 : "";
      }).filter(Boolean).join("　／　")), button("選び直す", "soul-reading__button soul-reading__button--quiet", () => openReviewPick(index)));
      picks.append(section);
    });
    content.append(picks);
    const actions = element("div", "soul-reading__review-actions");
    actions.append(
      button("この回答で魂を見る", "soul-reading__button soul-reading__button--primary", () => {
        if (!persistCompleted()) return;
        state.screen = "reveal";
        render();
      }),
      button("← Q14へ戻る", "soul-reading__back", () => {
        state.index = 13;
        state.screen = "pick";
        persistInProgress();
        render();
      })
    );
    content.append(actions); panel.append(content); app.append(panel);
  };

  const renderReveal = () => {
    const result = calculateSoulReading(state.answers, state.interests, state.wishes);
    const panel = element("section", "soul-reading__screen soul-reading__reveal");
    const content = element("div", "soul-reading__reveal-content");
    ["十四の答えに、優劣はない。", "通話でのあなたの居方が、", "形になって残った。"].forEach((line, index) => {
      const item = element("p", "soul-reading__reveal-line", line);
      item.style.setProperty("--reveal-delay", `${.25 + index * .9}s`);
      content.append(item);
    });
    const mark = element("div", "soul-reading__reveal-mark");
    mark.style.setProperty("--reveal-delay", "2.95s");
    mark.append(crest(result.soul.id)); content.append(mark);
    const next = button("魂を見る", "soul-reading__button soul-reading__button--outline", () => { state.screen = "result"; render(); });
    next.style.setProperty("--reveal-delay", "4.05s"); content.append(next);
    panel.append(content); app.append(panel);
  };

  const soulShape = (values: Record<string, number>) => {
    const centerX = 150; const centerY = 140; const radius = 112;
    const points = axes.map((axis, index) => {
      const angle = (-90 + index * 60) * Math.PI / 180;
      return `${(centerX + radius * values[axis] * Math.cos(angle)).toFixed(1)},${(centerY + radius * values[axis] * Math.sin(angle)).toFixed(1)}`;
    }).join(" ");
    const labels = axes.map((axis, index) => {
      const angle = (-90 + index * 60) * Math.PI / 180;
      return `<text x="${centerX + 132 * Math.cos(angle)}" y="${centerY + 132 * Math.sin(angle)}" text-anchor="middle">${axisLabels[axis]}</text>`;
    }).join("");
    return `<svg class="soul-reading__shape" viewBox="-22 0 344 280" role="img" aria-label="六つの傾向から描かれた魂の形"><polygon points="150,28 247,84 247,196 150,252 53,196 53,84" class="soul-reading__shape-grid"/><polygon points="150,78 203,109 203,171 150,202 97,171 97,109" class="soul-reading__shape-grid soul-reading__shape-grid--inner"/><polygon points="${points}" class="soul-reading__shape-fill"/>${labels}</svg>`;
  };
  const renderResult = () => {
    const result = calculateSoulReading(state.answers, state.interests, state.wishes);
    const panel = element("section", "soul-reading__screen soul-reading__result");
    const layout = element("div", "soul-reading__result-layout");
    const reading = element("div", "soul-reading__reading-column");
    const identity = element("header", "soul-reading__identity");
    const identityTop = element("div", "soul-reading__identity-top");
    identityTop.append(crest(result.soul.id), (() => { const wrap = element("div", "soul-reading__identity-name"); wrap.append(sectionLabel(result.soul.latin), heading(1, result.soul.name)); return wrap; })());
    identity.append(identityTop, element("p", "soul-reading__result-line", result.soul.line), element("div", "soul-reading__result-rule"));
    reading.append(identity);
    const body = element("div", "soul-reading__body");
    result.soul.body.forEach((paragraph) => body.append(element("p", undefined, paragraph)));
    if (result.showMix) body.append(element("p", "soul-reading__mix", result.second.mix));
    reading.append(body);
    const shapeWrap = element("section", "soul-reading__shape-section");
    shapeWrap.append(sectionLabel("魂の形"));
    const shape = element("div", "soul-reading__shape-wrap"); shape.innerHTML = soulShape(result.displayNorm); shapeWrap.append(shape, element("p", "soul-reading__shape-note", "回答から見えた形です。点数や順位ではありません。広い方向が優秀、狭い方向が苦手という意味ではなく、同じ魂型でも形は人ごとに違います。"));
    reading.append(shapeWrap);

    const action = element("aside", "soul-reading__action-column");
    const labeledList = (label: string, values: string[], className: string) => {
      const section = element("section", className); section.append(sectionLabel(label));
      values.forEach((value) => { const item = element("p", "soul-reading__entry"); item.append(element("span", "soul-reading__entry-mark", "—"), document.createTextNode(value)); section.append(item); });
      return section;
    };
    action.append(labeledList("入りやすい場面", result.easiest, "soul-reading__entry-section"));
    const activitySection = element("section", "soul-reading__activity-section"); activitySection.append(sectionLabel("城でまず気になっているもの"));
    result.activityCards.forEach((activity) => { const card = element("div", "soul-reading__activity-card"); card.append(heading(2, activity.name), element("p", undefined, activityNotes[activity.id])); activitySection.append(card); });
    const wishes = element("div", "soul-reading__wishes"); wishes.append(sectionLabel("一か月後に望んでいること")); result.oneMonthWishes.forEach((wish) => { const item = element("p", "soul-reading__wish"); item.append(element("span", undefined, "—"), document.createTextNode(wish.question14)); wishes.append(item); }); activitySection.append(wishes); action.append(activitySection);
    const first = element("section", "soul-reading__first"); first.append(sectionLabel("最初に試すこと"), element("p", undefined, result.soul.first)); action.append(first);
    const actions = element("div", "soul-reading__result-actions"); const join = document.createElement("a"); join.href = "/join"; join.className = "soul-reading__button soul-reading__button--primary"; join.textContent = "入城案内を見る　→"; actions.append(join, resultUrlShare(result.soul.id), button("結果画像をつくる", "soul-reading__button soul-reading__button--outline", () => { state.screen = "share"; render(); }), button("もう一度診断する", "soul-reading__button soul-reading__button--quiet", () => { state.confirmingDiscard = true; render(); }), element("p", "soul-reading__disclaimer", "通話での居方の傾向です。入城の可否、身分、評価、役職適性とは関係ありません。")); action.append(actions);
    layout.append(reading, action); panel.append(layout);
    const otherSouls = element("section", "soul-reading__other-souls"); otherSouls.append(sectionLabel("ほかの魂の一行")); const grid = element("div", "soul-reading__other-souls-grid");
    soulResultTypes.forEach((type) => { const card = element("article", `soul-reading__other-soul${type.id === result.soul.id ? " is-current" : ""}`); card.append(crest(type.id, "compact", "soul-reading__other-crest")); const copy = element("div", "soul-reading__other-copy"); copy.append(heading(2, type.name), element("p", undefined, type.line)); card.append(copy); grid.append(card); });
    otherSouls.append(grid); panel.append(otherSouls); if (state.confirmingDiscard) panel.append(renderDiscardConfirmation()); app.append(panel);
  };

  const loadImage = (src: string) => new Promise<HTMLImageElement>((resolve) => { const image = new Image(); image.onload = () => resolve(image); image.onerror = () => resolve(image); image.src = src; });
  const wrapCanvasText = (context: CanvasRenderingContext2D, text: string, width: number) => {
    const lines: string[] = []; let current = "";
    [...text].forEach((character) => { if (context.measureText(current + character).width > width && current) { lines.push(current); current = character; } else current += character; });
    if (current) lines.push(current); return lines;
  };
  const drawCanvasShape = (context: CanvasRenderingContext2D, values: Record<string, number>, centerX: number, centerY: number, radius: number) => {
    const point = (index: number, scale: number) => { const angle = (-90 + index * 60) * Math.PI / 180; return [centerX + radius * scale * Math.cos(angle), centerY + radius * scale * Math.sin(angle)] as const; };
    [1, .55].forEach((scale) => { context.beginPath(); axes.forEach((_, index) => { const p = point(index, scale); index ? context.lineTo(...p) : context.moveTo(...p); }); context.closePath(); context.strokeStyle = "rgba(236,231,221,.16)"; context.lineWidth = 1; context.stroke(); });
    context.beginPath(); axes.forEach((axis, index) => { const p = point(index, values[axis]); index ? context.lineTo(...p) : context.moveTo(...p); }); context.closePath(); context.fillStyle = "rgba(184,31,34,.34)"; context.fill(); context.strokeStyle = "#e0b26a"; context.lineWidth = 2.5; context.stroke();
  };
  const drawCanvas = async () => {
    const share = app.querySelector<HTMLElement>(".soul-reading__share");
    const canvas = app.querySelector<HTMLCanvasElement>("canvas");
    const loading = app.querySelector<HTMLElement>(".soul-reading__share-loading");
    const save = app.querySelector<HTMLButtonElement>("[data-share-save]");
    if (!canvas) return;
    let rendered = false;
    try {
      const context = canvas.getContext("2d");
      if (!context) throw new Error("Canvas context was not available.");
      await new Promise<void>((resolve) => setTimeout(resolve, 180));
      const result = calculateSoulReading(state.answers, state.interests, state.wishes);
      const [background, mark] = await Promise.all([loadImage("/images/diagnosis/share-bg-1080x1350.png"), loadImage(`/images/brand/crest/crest-${result.soul.id}.svg`)]);
      if (!background.naturalWidth || !mark.naturalWidth) throw new Error("Share image assets could not be loaded.");
      await document.fonts.ready;
      context.fillStyle = "#07060a"; context.fillRect(0, 0, 1080, 1350);
      context.drawImage(background, 0, 0, 1080, 1350);
      const shade = context.createLinearGradient(0, 0, 0, 1350); shade.addColorStop(0, "rgba(16,12,17,.12)"); shade.addColorStop(1, "rgba(7,6,10,.55)"); context.fillStyle = shade; context.fillRect(0, 0, 1080, 1350);
      context.strokeStyle = "rgba(224,178,106,.34)"; context.strokeRect(44, 44, 992, 1262); context.textAlign = "center";
      context.fillStyle = "#948d99"; context.font = "20px 'JetBrains Mono', monospace"; context.fillText("MEIGOKU CASTLE / SOUL READING", 540, 110);
      context.fillStyle = "#fff9ed"; context.font = "600 72px 'Shippori Mincho', serif"; context.fillText(result.soul.name, 540, 240);
      context.drawImage(mark, 390, 290, 300, 300);
      context.fillStyle = "#f3d79b"; context.font = "38px 'Shippori Mincho', serif"; wrapCanvasText(context, result.soul.line, 820).forEach((line, index) => context.fillText(line, 540, 650 + index * 54));
      drawCanvasShape(context, result.displayNorm, 540, 855, 130);
      context.fillStyle = "#948d99"; context.font = "20px 'JetBrains Mono', monospace"; context.fillText("城でまず気になっているもの", 540, 1090);
      context.fillStyle = "#ece7dd"; context.font = "28px 'Noto Sans JP', sans-serif"; context.fillText(result.activityCards.map((item) => item.name).join("　／　"), 540, 1145);
      context.fillStyle = "#948d99"; context.font = "19px 'JetBrains Mono', monospace"; context.fillText(siteConfig.publicSiteUrl ?? "冥獄城　魂の診断", 540, 1238);
      context.font = "18px 'Noto Sans JP', sans-serif"; context.fillText("通話での居方の傾向です。入城の可否・身分・評価とは関係ありません。", 540, 1286);
      rendered = true;
    } catch {
      if (loading) {
        loading.hidden = false;
        loading.textContent = "結果画像を描けませんでした。結果へ戻って、もう一度お試しください。";
      }
    } finally {
      share?.setAttribute("aria-busy", "false");
      if (rendered) {
        canvas.hidden = false;
        loading?.setAttribute("hidden", "");
        if (save) save.disabled = false;
      } else {
        canvas.hidden = true;
        if (save) save.disabled = true;
      }
    }
  };
  const renderShare = () => {
    const panel = element("section", "soul-reading__screen soul-reading__share"); panel.setAttribute("aria-busy", "true"); const content = element("div", "soul-reading__share-content");
    content.append(sectionLabel("SHARE IMAGE / 1080 × 1350")); const loading = element("p", "soul-reading__share-loading", "魂の形を描いています……"); loading.setAttribute("role", "status"); const canvas = document.createElement("canvas"); canvas.width = 1080; canvas.height = 1350; canvas.hidden = true; canvas.setAttribute("aria-label", "診断結果の共有画像"); content.append(loading, canvas);
    const actions = element("div", "soul-reading__share-actions"); const save = button("画像を保存する", "soul-reading__button soul-reading__button--outline", () => canvas.toBlob((blob) => { if (!blob) return; const link = document.createElement("a"); link.href = URL.createObjectURL(blob); link.download = "meigoku-soul.png"; link.click(); setTimeout(() => URL.revokeObjectURL(link.href), 500); })); save.disabled = true; save.dataset.shareSave = ""; actions.append(save, button("結果へ戻る", "soul-reading__button soul-reading__button--quiet", () => { state.screen = "result"; render(); }), element("p", "soul-reading__share-note", "ブラウザ内のCanvasで生成します。サーバー送信・外部API・課金は不要です。")); content.append(actions); panel.append(content); app.append(panel); requestAnimationFrame(drawCanvas);
  };
  window.addEventListener("storage", (event) => {
    if (event.key !== soulReadingProgressStorageKey || !event.newValue) return;
    const latest = loadSoulReadingProgress();
    if (!latest) return;
    externalProgress = latest;
    render();
  });
  render();
</script>
