---
import MainNavigation from "./MainNavigation.astro";
import Wordmark from "../brand/Wordmark.astro";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
---

<header class="site-header">
  <div class="container">
    <a href="/" aria-label="冥獄城トップへ"><Wordmark compact /></a>
    <MainNavigation currentPath={currentPath} />
  </div>
</header>
