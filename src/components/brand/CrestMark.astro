---
import { castleCrest, crestPaths, type CrestPath, type SoulId } from "../../data/brand";

interface Props { soul?: SoulId; variant?: "full" | "compact" | "auto" | "castle"; label?: string; inverted?: boolean; }
const { soul, variant = "auto", label, inverted = false } = Astro.props;
const compact = variant === "compact";
const paths: CrestPath[] = variant === "castle" ? castleCrest : crestPaths(soul ?? "tenka", compact);
const ariaLabel = label ?? (variant === "castle" ? "冥獄城の城紋" : `${soul ?? "tenka"}の魂紋`);
---

<svg class:list={["crest-mark", { "crest-mark--inverted": inverted, "crest-mark--auto": variant === "auto" }]} viewBox="0 0 100 100" role="img" aria-label={ariaLabel}>
  {paths.map((path) => <path d={path.d} fill={path.fill ? "currentColor" : "none"} stroke={path.fill ? "none" : "currentColor"} stroke-width={path.weight === "frame" ? 1.65 : path.weight === "detail" ? .8 : 1.25} stroke-dasharray={path.dash} stroke-linejoin="miter" stroke-linecap="square" />)}
</svg>

<style>
  .crest-mark { display:block; width:100%; height:100%; color:var(--color-lantern); }
  .crest-mark--inverted { color:var(--color-exterior); }
  @media (max-width: 47px) { .crest-mark--auto path { stroke-width: 2.4; } }
</style>
