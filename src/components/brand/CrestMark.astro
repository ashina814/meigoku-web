---
import type { SoulId } from "../../data/brand";

interface Props { soul?: SoulId; kind?: "soul" | "castle"; variant: "full" | "compact"; label?: string; inverted?: boolean; }
const { soul, kind = "soul", variant, label, inverted = false } = Astro.props;
const ariaLabel = label ?? (kind === "castle" ? "冥獄城の城紋" : `${soul ?? "tenka"}の魂紋`);
const name = kind === "castle" ? "crest-castle" : `crest-${soul ?? "tenka"}`;
const suffix = inverted ? "-ink" : variant === "compact" ? "-min" : "";
const src = `/images/brand/crest/${name}${suffix}.svg`;
---

<img class="crest-mark" src={src} alt={ariaLabel} width="100" height="100" />

<style>
  .crest-mark { display:block; width:100%; height:100%; object-fit:contain; }
</style>
