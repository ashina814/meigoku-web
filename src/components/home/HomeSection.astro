---
import PlaceholderNotice from "../ui/PlaceholderNotice.astro";

interface Props {
  id: string;
  title: string;
  placeholder: string;
}

const { id, title, placeholder } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`}>
  <div class="container">
    <h2 id={`${id}-title`}>{title}</h2>
    <PlaceholderNotice>{placeholder}</PlaceholderNotice>
  </div>
</section>
